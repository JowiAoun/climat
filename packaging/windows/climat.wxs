<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: 2026 Jowi Aoun
  SPDX-License-Identifier: GPL-3.0-or-later

  The Windows installer, in WiX v5.

  ==== why an MSI, and not MSIX ==============================================

  docs/07-packaging.md §7.1 lists "signed MSIX" as the P0 Windows channel. That
  is corrected here, and the reason is signing. We do not have a certificate.
  An unsigned MSIX cannot be side-loaded at all without the user first
  importing a certificate into their trusted root store, which is a worse thing
  to ask than SmartScreen's warning - it is teaching people to trust an
  arbitrary publisher certificate. An unsigned MSI simply warns.

  MSI also gets three things MSIX does not: winget validates it natively, it
  installs per-user without administrator rights, and it produces a clean
  Add/Remove Programs entry with a real upgrade code.

  What it does not get is a signature, and the consequence is a SmartScreen
  "unknown publisher" dialog on first run. That is recorded in
  docs/known-gaps.md with the three mitigations, in order.

  ==== building it ===========================================================

  Not by CPack. CPack's WIX generator targets WiX v3, which is end of life.
  The windows job in .github/workflows/release.yml installs WiX 5 as a dotnet
  tool and runs `wix build` on this file, with the version passed in as the
  variable Version and two bind paths: `stage`, the staged install, and
  `icons`, packaging/icons. The exact lines are there and not here, because an
  XML comment cannot hold the double hyphen every one of those flags starts
  with.

  The staged tree is the output of CMake's install step with windeployqt
  already run into it, plus the two licence files the LGPL requires beside a
  bundled Qt.

  NOT VERIFIED. There is no MSVC and no Windows in the development environment
  this was written in, so this file has never been compiled by `wix build`.
  Treat the first release run as the test it has not had - the same footing
  the Android job is on.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Climat"
      Manufacturer="Jowi Aoun"
      Version="$(var.Version)"
      Language="1033"
      Compressed="yes"
      Scope="perUser"
      UpgradeCode="93D3BED3-F1B0-4932-A5A6-5A59C6146B08">

    <!--
      The UpgradeCode above must never change for the lifetime of the product.
      It is the identity Windows uses to recognise that this MSI supersedes the
      one already installed; change it and every future release installs
      alongside its predecessor instead of replacing it, and the user
      accumulates one Add/Remove entry per version.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you meant to go back." />

    <MediaTemplate EmbedCab="yes" />

    <SummaryInformation
        Description="Climat - native weather app with charts and severe weather warnings" />

    <Icon Id="ClimatIcon" SourceFile="!(bindpath.icons)\climat.ico" />
    <Property Id="ARPPRODUCTICON" Value="ClimatIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/JowiAoun/climat" />
    <Property Id="ARPHELPLINK" Value="https://github.com/JowiAoun/climat/issues" />

    <!--
      Under LocalAppData rather than Program Files, which is what Scope="perUser"
      means in practice: no UAC prompt, no administrator, and an install that a
      user on a managed machine can actually perform. It is also why there is no
      per-machine variant here - supporting both doubles the install conditions
      and the second one is the one nobody can run at work.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Climat" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Climat" Level="1">
      <ComponentGroupRef Id="ClimatFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      Harvested rather than enumerated. The staged tree is whatever windeployqt
      decided Qt needs - around forty DLLs and a handful of plugin directories -
      and a hand-written file list would be a second opinion about that,
      regenerated by hand on every Qt update. `Files` walks the bind path.
    -->
    <ComponentGroup Id="ClimatFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut
          Id="ClimatStartMenu"
          Name="Climat"
          Description="Check the forecast and severe weather warnings"
          Target="[INSTALLFOLDER]bin\climat.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="ClimatIcon" />

      <!--
        A per-user component needs a keypath under HKCU. Without it the
        component has no way to record that it is installed for this user, and
        the MSI either refuses to validate or reinstalls the shortcut on every
        repair. The value itself is never read by anything.
      -->
      <RegistryValue
          Root="HKCU"
          Key="Software\Climat"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
